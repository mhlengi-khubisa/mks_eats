{
  "name": "township-market/platform",
  "description": "A multi-vendor marketplace for South African community businesses.",
  "type": "project",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^12.0",
    "laravel/sanctum": "^4.0",
    "livewire/livewire": "^3.5",
    "barryvdh/laravel-dompdf": "^3.1"
  },
  "require-dev": {"fakerphp/faker": "^1.23", "laravel/pint": "^1.18", "phpunit/phpunit": "^11.0"},
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {"setup": ["@php artisan key:generate", "@php artisan migrate --seed"], "test": ["@php artisan test"]},
  "minimum-stability": "stable",
  "prefer-stable": true
}
